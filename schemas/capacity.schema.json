{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capacity.json — /capacity AI-megawatts tracker",
  "type": "object",
  "required": ["published_at", "as_of_curated", "priced_date", "note", "basis",
               "companies", "cohorts", "timeline", "tenants", "geo",
               "geo_unmapped", "geo_note", "reference"],
  "properties": {
    "published_at": {"type": "string"},
    "as_of_curated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "priced_date": {"type": ["string", "null"]},
    "note": {"type": "string"},
    "basis": {"type": "object"},
    "companies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "n", "role", "dupe", "private", "confidence",
                     "op", "con", "plan", "cap", "px", "priced_date", "stale",
                     "ev", "wmw", "ev_per_mw", "pct_energized", "coverage",
                     "valuation_b", "sites", "src", "tl"],
        "properties": {
          "t": {"type": "string"},
          "n": {"type": "string"},
          "role": {"enum": ["neocloud", "landlord", "operator",
                            "hyperscaler", "exploratory"]},
          "dupe": {"type": ["string", "null"]},
          "ev_note": {"type": ["string", "null"], "description": "why EV/MW is withheld for this row (2026-10-07+)"},
          "private": {"type": "boolean"},
          "confidence": {"enum": ["filed", "estimate"]},
          "op": {"type": "number", "minimum": 0},
          "con": {"type": "number", "minimum": 0},
          "plan": {"type": "number", "minimum": 0},
          "cap": {"type": ["number", "null"]},
          "px": {"type": ["number", "null"]},
          "priced_date": {"type": ["string", "null"]},
          "stale": {"type": "boolean"},
          "ev": {"type": ["number", "null"]},
          "wmw": {"type": "number", "minimum": 0},
          "ev_per_mw": {"type": ["number", "null"]},
          "pct_energized": {"type": ["number", "null"]},
          "coverage": {"type": ["number", "null"]},
          "valuation_b": {"type": ["number", "null"]},
          "nd": {"type": ["number", "null"]},
          "bk": {"type": ["number", "null"]},
          "sites": {"type": "array"},
          "src": {"type": "array"},
          "tl": {"type": "array", "items": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "prefixItems": [{"type": "string", "pattern": "^\\d{4}Q[1-4]$"},
                            {"type": "string"}, {"type": "number"}]}}
        }
      }
    },
    "cohorts": {
      "type": "object",
      "required": ["all", "neocloud", "hyperscaler"],
      "additionalProperties": {
        "type": "object",
        "required": ["companies", "op", "con", "plan"],
        "properties": {"companies": {"type": "integer", "minimum": 0},
                       "op": {"type": "number"}, "con": {"type": "number"},
                       "plan": {"type": "number"}}
      }
    },
    "timeline": {
      "type": "object",
      "required": ["all", "neocloud", "hyperscaler"],
      "additionalProperties": {
        "type": "object",
        "required": ["base_mw", "points", "milestones"],
        "properties": {
          "base_mw": {"type": "number"},
          "points": {"type": "array", "items": {
            "type": "object",
            "required": ["q", "add_mw", "cum_mw"],
            "properties": {"q": {"type": "string", "pattern": "^\\d{4}Q[1-4]$"},
                           "add_mw": {"type": "number"},
                           "cum_mw": {"type": "number"}}}},
          "milestones": {"type": "object"}
        }
      }
    },
    "tenants": {"type": "array", "items": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [{"type": "string"}, {"type": "string"},
                      {"type": ["number", "null"]}, {"type": "string"}]}},
    "geo": {"type": "array", "items": {
      "type": "object",
      "required": ["t", "site", "mw", "st", "lat", "lng", "approx"],
      "properties": {"t": {"type": "string"}, "site": {"type": "string"},
                     "mw": {"type": ["number", "null"]},
                     "st": {"enum": ["o", "c", "p", "s"]},
                     "lat": {"type": "number", "minimum": -90, "maximum": 90},
                     "lng": {"type": "number", "minimum": -180, "maximum": 180},
                     "approx": {"type": "boolean"},
                     "when": {"type": "string"},
                     "market": {"type": "string"}}}},
    "geo_unmapped": {"type": "array", "items": {
      "type": "object",
      "required": ["t", "site", "mw", "st", "why"],
      "properties": {"t": {"type": "string"}, "site": {"type": "string"},
                     "mw": {"type": ["number", "null"]},
                     "st": {"enum": ["o", "c", "p", "s"]},
                     "why": {"type": "string"}}}},
    "geo_note": {"type": "string"},
    "reference": {
      "type": "object",
      "required": ["nvda_cap_b", "cohort_ev_b"],
      "properties": {"nvda_cap_b": {"type": ["number", "null"]},
                     "cohort_ev_b": {"type": ["number", "null"]}}
    },
    "power_deals": {
      "description": "curated PPAs and other dedicated supply deals behind the tracked companies (2026-10-08+); optional so older files validate",
      "type": "object",
      "required": ["as_of_curated", "basis", "mw_note", "totals", "deals"],
      "additionalProperties": false,
      "properties": {
        "as_of_curated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "basis": {"type": "string"},
        "mw_note": {"type": "string"},
        "totals": {
          "type": "object",
          "required": ["signed_mw", "signed_ppa_mw", "pending_mw", "preliminary_mw", "deals"],
          "additionalProperties": false,
          "properties": {"signed_mw": {"type": "number"}, "signed_ppa_mw": {"type": "number"},
                         "pending_mw": {"type": "number"}, "preliminary_mw": {"type": "number"},
                         "deals": {"type": "integer"}}
        },
        "deals": {"type": "array", "items": {
          "type": "object",
          "required": ["t", "name", "counterparty", "facility", "technology", "mw", "sites", "mw_total",
                       "mw_basis", "status", "kind", "instrument", "announced", "term_years", "start",
                       "source", "quote", "note"],
          "additionalProperties": false,
          "properties": {
            "t": {"type": "string"}, "name": {"type": "string"},
            "counterparty": {"type": "string"}, "facility": {"type": "string"},
            "technology": {"type": "string"},
            "mw": {"type": "number", "minimum": 100}, "sites": {"type": "integer", "minimum": 1},
            "mw_total": {"type": "number"},
            "mw_basis": {"enum": ["contracted", "nameplate"]},
            "status": {"enum": ["signed", "pending", "mou", "loi", "option"]},
            "kind": {"enum": ["ppa", "utility supply", "development / funding", "other"]},
            "instrument": {"type": "string"},
            "announced": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
            "term_years": {"type": ["integer", "null"]},
            "start": {"type": ["string", "null"]},
            "source": {"type": "object", "required": ["publisher", "title", "url"], "additionalProperties": false,
                       "properties": {"publisher": {"type": "string"}, "title": {"type": "string"},
                                      "url": {"type": "string"}}},
            "quote": {"type": "string"},
            "note": {"type": ["string", "null"]}
          }
        }}
      }
    }
  }
}
