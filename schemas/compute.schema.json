{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compute",
  "type": "object",
  "required": ["published_at", "history_start", "blend", "models", "token_index", "gpus", "gpu_index"],
  "additionalProperties": false,
  "properties": {
    "published_at": {"type": "string"},
    "history_start": {"type": ["string", "null"]},
    "blend": {
      "type": "object",
      "required": ["in", "out", "min_members", "method"],
      "additionalProperties": false,
      "properties": {
        "in": {"type": "number"},
        "out": {"type": "number"},
        "min_members": {"type": "integer", "minimum": 1},
        "method": {"type": "string"}
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "in_usd_mtok", "out_usd_mtok", "blended_usd_mtok", "as_of",
                     "chg_30d_pct", "tail"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "label": {"type": "string"},
          "tier": {"description": "Our frontier / standard / light label after Ramp's split of enterprise model spend; a table label, never an index weight. Added 2026-10-08; optional.",
                   "enum": ["frontier", "standard", "light"]},
          "in_usd_mtok": {"$ref": "#/$defs/num"},
          "out_usd_mtok": {"$ref": "#/$defs/num"},
          "blended_usd_mtok": {"$ref": "#/$defs/num"},
          "as_of": {"$ref": "#/$defs/day"},
          "chg_30d_pct": {"$ref": "#/$defs/num"},
          "tail": {"$ref": "#/$defs/tail"}
        }
      }
    },
    "token_index": {"$ref": "#/$defs/index"},
    "token_roster": {
      "description": "The date the current model roster took over and the models it replaced (link-only up to the base date). Added 2026-10-07; optional.",
      "type": "object",
      "required": ["since", "retired"],
      "additionalProperties": false,
      "properties": {
        "since": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "retired": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "label", "usd_per_gpu_hr", "as_of", "chg_30d_pct", "tail"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "label": {"type": "string"},
          "usd_per_gpu_hr": {"$ref": "#/$defs/num"},
          "as_of": {"$ref": "#/$defs/day"},
          "chg_30d_pct": {"$ref": "#/$defs/num"},
          "tail": {"$ref": "#/$defs/tail"},
          "in_index": {"type": "boolean"},
          "stale": {"type": "boolean", "description": "last obs older than the registry staleness limit (2026-10-07+)"}
        }
      }
    },
    "gpu_index": {"$ref": "#/$defs/index"},
    "cloud_gpus": {
      "description": "Cloud on-demand LIST prices per GPU-hour: display-only, never gpu_index members. Added 2026-10-07; optional so older compute.json files still validate.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "provider", "gpu", "instance", "gpus_per_instance", "region",
                     "usd_per_gpu_hr", "usd_per_instance_hr", "as_of", "chg_30d_pct", "stale"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "provider": {"type": "string"},
          "gpu": {"type": "string"},
          "instance": {"type": "string"},
          "gpus_per_instance": {"type": "integer", "minimum": 1},
          "region": {"type": "string"},
          "usd_per_gpu_hr": {"$ref": "#/$defs/num"},
          "usd_per_instance_hr": {"$ref": "#/$defs/num"},
          "as_of": {"$ref": "#/$defs/day"},
          "chg_30d_pct": {"$ref": "#/$defs/num"},
          "stale": {"type": "boolean", "description": "last obs older than the registry staleness limit: shown with its date, kept out of current ranges"},
          "reserved": {
            "description": "the provider's posted reservation prices for this SKU, per GPU-hour (Azure only; 2026-10-08+)",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["term_years", "usd_per_gpu_hr", "discount_pct", "as_of", "stale"],
              "additionalProperties": false,
              "properties": {
                "term_years": {"type": "integer", "minimum": 1},
                "usd_per_gpu_hr": {"$ref": "#/$defs/num"},
                "discount_pct": {"$ref": "#/$defs/num", "description": "vs the row's on-demand price"},
                "as_of": {"$ref": "#/$defs/day"},
                "stale": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "reserved_notes": {
      "description": "why each other provider has no reserved price here (2026-10-08+)",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "capability": {
      "description": "$ per dense BF16 PFLOP-hour by GPU generation, over the curated NVIDIA spec table (2026-10-08+)",
      "type": "object",
      "required": ["basis", "basis_note", "publisher", "as_of_curated", "by_generation"],
      "additionalProperties": false,
      "properties": {
        "basis": {"type": "string"},
        "basis_note": {"type": "string"},
        "publisher": {"type": "string"},
        "as_of_curated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "by_generation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gpu", "dense_bf16_tflops", "spec_url", "list_median_usd_per_gpu_hr", "list_quotes",
                         "list_usd_per_pflop_hr", "reserved_3y_usd_per_pflop_hr", "market_usd_per_pflop_hr"],
            "additionalProperties": false,
            "properties": {
              "gpu": {"type": "string"},
              "dense_bf16_tflops": {"type": "number", "exclusiveMinimum": 0},
              "spec_url": {"type": "string"},
              "list_median_usd_per_gpu_hr": {"$ref": "#/$defs/num"},
              "list_quotes": {"type": "integer", "minimum": 0},
              "list_usd_per_pflop_hr": {"$ref": "#/$defs/num"},
              "reserved_3y_usd_per_pflop_hr": {"$ref": "#/$defs/num"},
              "market_usd_per_pflop_hr": {"$ref": "#/$defs/num"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "num": {"type": ["number", "null"]},
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tail": {
      "type": "object",
      "required": ["dates", "values"],
      "additionalProperties": false,
      "properties": {
        "dates": {"type": "array", "items": {"type": "string"}},
        "values": {"type": "array", "items": {"type": "number"}}
      }
    },
    "index": {
      "type": "object",
      "required": ["base_date", "history", "value", "as_of", "chg_30d_pct"],
      "additionalProperties": false,
      "properties": {
        "base_date": {"$ref": "#/$defs/day"},
        "history": {
          "type": "object",
          "required": ["dates", "index", "members"],
          "additionalProperties": false,
          "properties": {
            "dates": {"type": "array", "items": {"type": "string"}},
            "index": {"type": "array", "items": {"type": ["number", "null"]}},
            "members": {"type": "array", "items": {"type": "integer"}}
          }
        },
        "value": {"$ref": "#/$defs/num"},
        "as_of": {"$ref": "#/$defs/day"},
        "chg_30d_pct": {"$ref": "#/$defs/num"}
      }
    }
  }
}
