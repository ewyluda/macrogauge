{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dc_grades.json — /dc-scoreboard escalation grading harness",
  "type": "object",
  "required": ["published_at", "as_of", "legs", "anchors", "scenarios",
               "revision_disclosure_pp", "leadlag", "power_nowcast"],
  "properties": {
    "published_at": {"type": "string"},
    "as_of": {"type": ["string", "null"]},
    "paired_legs_note": {"type": "string"},
    "revision_disclosure_pp": {"type": "number"},
    "legs": {
      "type": "object",
      "description": "Keyed by leg name (\"strict\"/\"extended\" in the normal case; {} when degraded). Leg objects legally carry DIFFERENT horizon key sets under `grades` -- the strict leg publishes only h12/h24 (spec 2.1a) -- so no leg schema below requires a fixed set of horizon keys.",
      "additionalProperties": {
        "type": "object",
        "required": ["provenance", "span", "anchors_n", "contains_downturn",
                     "published_horizons", "grades"],
        "properties": {
          "provenance": {"type": "string"},
          "span": {"type": "array", "items": {"type": ["string", "null"]}},
          "anchors_n": {"type": "integer"},
          "contains_downturn": {"type": "boolean"},
          "published_horizons": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "Which horizons THIS leg actually grades -- read this, never assume all four (spec: 'the strict leg publishes only h=12 and h=24')."
          },
          "grades": {
            "type": "object",
            "description": "basis_key -> horizon_key -> stats|null. No horizon_key is required to be present for every basis/leg -- a horizon absent from `published_horizons` is simply not a key here.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": ["object", "null"],
                "required": ["n", "independent_draws", "shortfall_rate_pct",
                             "mean_shortfall_pp", "worst_shortfall_pp",
                             "bias_pp", "mae_pp"],
                "properties": {
                  "n": {"type": "integer"},
                  "independent_draws": {"type": "number"},
                  "shortfall_rate_pct": {"type": "number"},
                  "mean_shortfall_pp": {"type": "number"},
                  "worst_shortfall_pp": {"type": "number"},
                  "bias_pp": {"type": "number"},
                  "mae_pp": {"type": "number"}
                }
              }
            }
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["m", "leg", "bases", "realized"],
        "properties": {
          "m": {"type": "string"},
          "leg": {"type": "string"},
          "bases": {"type": "object",
                    "additionalProperties": {"type": ["number", "null"]}},
          "realized": {"type": "object",
                       "additionalProperties": {"type": ["number", "null"]}}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Hindsight-selected regimes (GFC, COVID peak): rates and windows ONLY, never a grading statistic (spec 5.3) -- enforced below by validation, not convention.",
      "items": {
        "type": "object",
        "required": ["key", "label", "start_month", "end_month",
                     "annualized_pct", "hindsight_selected", "note"],
        "not": {"anyOf": [
          {"required": ["shortfall_rate_pct"]}, {"required": ["mae_pp"]},
          {"required": ["bias_pp"]}, {"required": ["n"]},
          {"required": ["independent_draws"]},
          {"required": ["mean_shortfall_pp"]},
          {"required": ["worst_shortfall_pp"]}
        ]},
        "properties": {
          "key": {"type": "string"},
          "label": {"type": "string"},
          "start_month": {"type": "string"},
          "end_month": {"type": "string"},
          "annualized_pct": {"type": ["number", "null"]},
          "hindsight_selected": {"const": true},
          "note": {"type": "string"}
        }
      }
    },
    "leadlag": {
      "type": ["object", "null"],
      "description": "P3c's lead-lag study, or null on a fully degraded run. A positive gate result (weight_stable > 0) must NEVER be rendered without `caveats` and `conclusion` alongside it -- spec 6.1 requires both to travel with the gate's literal outcome everywhere it appears, structurally, not as prose a reader can skip.",
      "required": ["mappings", "weight_covered", "weight_stable", "verdict",
                   "gate", "caveats", "conclusion"],
      "properties": {
        "weight_covered": {"type": "number"},
        "weight_stable": {"type": "number"},
        "verdict": {"type": "string"},
        "gate": {"type": "string"},
        "conclusion": {
          "type": "string",
          "description": "The standing finding -- independent of the literal gate outcome -- that no forward model is warranted on this evidence (spec 6.1)."
        },
        "caveats": {
          "type": "array",
          "description": "Structured caveats a consumer can render without parsing English. Empty only when no mapping cleared the gate (nothing positive to caveat).",
          "items": {
            "type": "object",
            "required": ["key", "text"],
            "properties": {
              "key": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["driver", "driver_label", "component",
                         "component_label", "weight", "months", "span",
                         "best_lag_months", "best_correlation", "stable",
                         "first_half", "second_half", "profile"],
            "properties": {
              "driver": {"type": "string"},
              "driver_label": {"type": "string"},
              "component": {"type": "string"},
              "component_label": {"type": "string"},
              "weight": {"type": "number"},
              "months": {"type": "integer"},
              "span": {"type": "array",
                       "items": {"type": ["string", "null"]}},
              "best_lag_months": {"type": ["integer", "null"]},
              "best_correlation": {"type": ["number", "null"]},
              "stable": {"type": "boolean"},
              "first_half": {
                "type": "object",
                "required": ["best_lag_months", "best_correlation"],
                "properties": {
                  "best_lag_months": {"type": ["integer", "null"]},
                  "best_correlation": {"type": ["number", "null"]}
                }
              },
              "second_half": {
                "type": "object",
                "required": ["best_lag_months", "best_correlation"],
                "properties": {
                  "best_lag_months": {"type": ["integer", "null"]},
                  "best_correlation": {"type": ["number", "null"]}
                }
              },
              "profile": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lag", "corr"],
                  "properties": {
                    "lag": {"type": "integer"},
                    "corr": {"type": ["number", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "power_nowcast": {
      "type": ["object", "null"],
      "required": ["as_of", "months_graded", "carry_forward_mae",
                   "best_lambda", "best_mae", "verdict", "note"],
      "properties": {
        "as_of": {"type": ["string", "null"]},
        "months_graded": {"type": "integer"},
        "carry_forward_mae": {"type": ["number", "null"]},
        "best_lambda": {"type": ["number", "null"]},
        "best_mae": {"type": ["number", "null"]},
        "verdict": {"enum": ["PASS", "FAIL", "INSUFFICIENT"]},
        "note": {"type": "string"}
      }
    }
  }
}
