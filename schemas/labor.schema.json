{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "labor",
  "type": "object",
  "required": ["published_at", "payrolls", "unemployment", "claims", "wages", "history"],
  "additionalProperties": false,
  "properties": {
    "published_at": {"type": "string"},
    "payrolls": {
      "type": "object", "additionalProperties": false,
      "required": ["level_k", "mom_change_k", "yoy_pct", "as_of"],
      "properties": {
        "level_k": {"type": ["number", "null"]},
        "mom_change_k": {"type": ["number", "null"]},
        "yoy_pct": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "unemployment": {
      "type": "object", "additionalProperties": false,
      "required": ["rate", "delta_1y_pp", "as_of"],
      "properties": {
        "rate": {"type": ["number", "null"]},
        "delta_1y_pp": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["initial", "initial_4wk_avg", "continued", "as_of"],
      "properties": {
        "initial": {"type": ["number", "null"]},
        "initial_4wk_avg": {"type": ["number", "null"]},
        "continued": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "wages": {
      "type": "object", "additionalProperties": false,
      "required": ["ahe_yoy_pct", "atlanta_wgt_pct", "as_of"],
      "properties": {
        "ahe_yoy_pct": {"type": ["number", "null"]},
        "atlanta_wgt_pct": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "construction": {
      "description": "Construction labour band (USCONS, CES2000000003 vs all-private AHE at the same month, JOLTS construction openings). Added 2026-10-08; optional so older labor.json files still validate.",
      "type": "object", "additionalProperties": false,
      "required": ["employment_k", "mom_change_k", "employment_yoy_pct", "employment_as_of", "ahe", "ahe_yoy_pct", "private_ahe_yoy_pct", "ahe_as_of", "openings_k", "openings_1y_ago_k", "openings_rate", "openings_as_of"],
      "properties": {
        "employment_k": {"type": ["number", "null"]},
        "mom_change_k": {"type": ["number", "null"]},
        "employment_yoy_pct": {"type": ["number", "null"]},
        "employment_as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "ahe": {"type": ["number", "null"]},
        "ahe_yoy_pct": {"type": ["number", "null"]},
        "private_ahe_yoy_pct": {"type": ["number", "null"]},
        "ahe_as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "openings_k": {"type": ["number", "null"]},
        "openings_1y_ago_k": {"type": ["number", "null"]},
        "openings_rate": {"type": ["number", "null"]},
        "openings_as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "construction_mix": {
      "description": "Non-craft share of construction jobs: all employees (USCONS) less production and nonsupervisory employees (CES2000000006, craft incl. working supervisors), monthly from 1990-01; and of payroll, each group priced at its average weekly earnings (CES2000000011 all employees from 2006-03, CES2000000030 craft). Added 2026-10-08; optional so older labor.json files still validate.",
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "craft_k", "noncraft_k", "noncraft_share_pct", "noncraft_per_100_craft", "share_1y_ago_pct", "payroll_as_of", "noncraft_payroll_share_pct", "noncraft_pay_ratio", "history"],
      "properties": {
        "as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "craft_k": {"type": ["number", "null"]},
        "noncraft_k": {"type": ["number", "null"]},
        "noncraft_share_pct": {"type": ["number", "null"]},
        "noncraft_per_100_craft": {"type": ["number", "null"]},
        "share_1y_ago_pct": {"type": ["number", "null"]},
        "payroll_as_of": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "noncraft_payroll_share_pct": {"type": ["number", "null"]},
        "noncraft_pay_ratio": {"type": ["number", "null"], "description": "implied non-craft average weekly earnings / craft average weekly earnings"},
        "history": {
          "type": "object", "additionalProperties": false,
          "required": ["months", "craft_k", "noncraft_k", "noncraft_share_pct", "noncraft_payroll_share_pct"],
          "properties": {
            "months": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
            "craft_k": {"type": "array", "items": {"type": "number"}},
            "noncraft_k": {"type": "array", "items": {"type": "number"}},
            "noncraft_share_pct": {"type": "array", "items": {"type": "number"}},
            "noncraft_payroll_share_pct": {"type": "array", "items": {"type": ["number", "null"]}}
          }
        }
      }
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["monthly", "weekly"],
      "properties": {
        "monthly": {
          "type": "object", "additionalProperties": false,
          "required": ["months", "payrolls_yoy_pct", "unemployment_rate"],
          "properties": {
            "months": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
            "payrolls_yoy_pct": {"type": "array", "items": {"type": ["number", "null"]}},
            "construction_yoy_pct": {"type": "array", "items": {"type": ["number", "null"]}, "description": "Construction employment (USCONS) YoY; optional, added 2026-10-08"},
            "unemployment_rate": {"type": "array", "items": {"type": ["number", "null"]}}
          }
        },
        "weekly": {
          "type": "object", "additionalProperties": false,
          "required": ["dates", "initial_claims"],
          "properties": {
            "dates": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
            "initial_claims": {"type": "array", "items": {"type": ["number", "null"]}}
          }
        }
      }
    }
  }
}
