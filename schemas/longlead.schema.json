{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "longlead.json \u2014 /longlead vendor order-book board (P4)",
  "type": "object",
  "required": [
    "published_at",
    "as_of_curated",
    "build_weight_covered",
    "teaser",
    "packages"
  ],
  "properties": {
    "published_at": {
      "type": "string"
    },
    "as_of_curated": {
      "type": "string",
      "minLength": 1
    },
    "build_weight_covered": {
      "type": "number"
    },
    "teaser": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vendor",
          "name",
          "stale",
          "figure"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stale": {
            "type": "boolean"
          },
          "figure": {
            "$ref": "#/$defs/figure"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "weight",
          "price_yoy_pct",
          "price_last_obs",
          "contribution_pp",
          "null_note",
          "vendors"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number"
          },
          "price_yoy_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "price_last_obs": {
            "type": [
              "string",
              "null"
            ]
          },
          "contribution_pp": {
            "type": [
              "number",
              "null"
            ]
          },
          "null_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "name",
                "ticker",
                "listed",
                "dc_segment",
                "cadence",
                "stale",
                "figures",
                "null_note"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "ticker": {
                  "type": "string",
                  "minLength": 1
                },
                "listed": {
                  "type": "string",
                  "minLength": 1
                },
                "dc_segment": {
                  "type": "string",
                  "minLength": 1
                },
                "cadence": {
                  "type": "string",
                  "enum": [
                    "quarterly",
                    "annual"
                  ]
                },
                "stale": {
                  "type": "boolean"
                },
                "figures": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/figure"
                  }
                },
                "null_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "disclosure_note": {
                  "description": "why the newest figures are older than the cadence implies; added 2026-10-07",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "backlog_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "lead_times": {
            "description": "Stated lead times (survey weeks or a vendor's order horizon); added 2026-10-07, optional so older files validate",
            "type": "array",
            "items": {
              "$ref": "#/$defs/lead_time"
            }
          }
        }
      }
    },
    "backlog_months": {
      "description": "Census M3 months of backlog (SA unfilled orders / SA monthly shipments) per industry group; added 2026-10-01",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "months",
          "ratio",
          "latest",
          "latest_month",
          "change_1y"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          "ratio": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "latest": {
            "type": "number"
          },
          "latest_month": {
            "type": "string"
          },
          "change_1y": {
            "type": [
              "number",
              "null"
            ]
          },
          "unfilled_yoy_pct": {
            "type": "number",
            "description": "unfilled orders, % vs a year earlier (added 2026-10-07)"
          },
          "shipments_yoy_pct": {
            "type": "number",
            "description": "shipments, % vs a year earlier (added 2026-10-07)"
          }
        }
      }
    },
    "lead_time_benchmark": {
      "description": "one all-equipment reference lead time; added 2026-10-07",
      "anyOf": [
        {
          "$ref": "#/$defs/lead_time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "required": [
        "metric",
        "kind",
        "basis",
        "scope",
        "value",
        "unit",
        "period",
        "asof",
        "quote",
        "src"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "backlog",
            "orders",
            "book_to_bill",
            "backlog_growth"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "rpo",
            "order-backlog",
            "mdna-backlog"
          ],
          "description": "Three different accounting objects \u2014 never sum figures across bases, never share an axis (spec \u00a72.4)"
        },
        "scope": {
          "type": "string",
          "enum": [
            "group",
            "segment",
            "product-line"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "usd_b",
            "eur_b",
            "jpy_tn",
            "pct_yoy",
            "ratio",
            "gw"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "asof": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "lead_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "weeks",
        "through",
        "basis",
        "period",
        "asof",
        "stale",
        "quote",
        "src"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "weeks": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "through": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}$"
        },
        "basis": {
          "type": "string",
          "enum": [
            "industry-survey",
            "industry-report",
            "vendor-statement"
          ]
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "asof": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "stale": {
          "type": "boolean"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
