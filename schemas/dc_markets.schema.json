{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dc_markets.json — /markets DC market panel",
  "type": "object",
  "required": ["published_at", "as_of", "base_date", "as_of_curated", "note",
               "national", "markets", "coverage_note"],
  "properties": {
    "published_at": {"type": "string"},
    "as_of": {"type": ["string", "null"]},
    "base_date": {"type": ["string", "null"]},
    "as_of_curated": {"type": "string"},
    "note": {"type": "string"},
    "coverage_note": {"type": "string"},
    "national": {
      "type": "object",
      "required": ["wage", "wage_yoy_pct", "emp", "emp_yoy_pct", "as_of"],
      "properties": {
        "wage": {"type": ["number", "null"]},
        "wage_yoy_pct": {"type": ["number", "null"]},
        "emp": {"type": ["integer", "null"]},
        "emp_yoy_pct": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"]}
      }
    },
    "elec_national": {
      "description": "Private NAICS 238212 (nonresidential electrical contractors) national baseline. Additive (2026-10): optional so artifacts published before it landed still validate; the writer always emits it (pinned by tests/test_dc_markets_writer.py).",
      "type": "object",
      "required": ["wage", "wage_yoy_pct", "emp", "emp_yoy_pct", "as_of"],
      "properties": {
        "wage": {"type": ["number", "null"]},
        "wage_yoy_pct": {"type": ["number", "null"]},
        "emp": {"type": ["integer", "null"]},
        "emp_yoy_pct": {"type": ["number", "null"]},
        "as_of": {"type": ["string", "null"]}
      }
    },
    "market_pipeline_source": {
      "description": "The one broker report behind every row's market_pipeline (config/dc_market_pipeline.json), its single basis, and whether it is past its refresh window. Additive (2026-10): optional so older artifacts validate; null when the config failed to load (the column is then absent). The writer always emits the key (tests/test_dc_markets_writer.py).",
      "type": ["object", "null"],
      "required": ["publisher", "doc", "doc_date", "period", "url", "basis", "basis_note", "stale_after_days", "stale"],
      "additionalProperties": false,
      "properties": {
        "publisher": {"type": "string"},
        "doc": {"type": "string"},
        "doc_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "period": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "url": {"type": "string", "pattern": "^https://"},
        "basis": {"type": "string", "enum": ["colo+hyperscale-self-build"]},
        "basis_note": {"type": "string"},
        "stale_after_days": {"type": "integer"},
        "stale": {"type": "boolean"}
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "state", "iso", "grid", "utility", "note",
                     "as_of", "base_date", "available", "thin_base", "wage",
                     "wage_cur", "wage_yoy_pct", "wage_spread_pp", "emp",
                     "emp_cur_total", "emp_yoy_pct", "emp_spread_pp",
                     "yoy_basis", "counties", "counties_total",
                     "counties_used", "counties_suppressed", "sites",
                     "mw_disclosed", "sites_mw_undisclosed", "mw_construction",
                     "mw_planned", "mw_secured", "mw_operating"],
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "state": {"type": "string"},
          "iso": {"type": ["string", "null"]},
          "grid": {"type": ["string", "null"]},
          "utility": {"type": "string"},
          "note": {"type": "string"},
          "county_names": {"type": "object", "additionalProperties": {"type": "string"}},
          "history": {"description": "last 8 QCEW quarters of construction headcount and weighted wage over the counties reported in all of them (2026-10-07+)",
            "type": "object", "required": ["quarters", "emp", "wage", "counties", "fips"], "additionalProperties": false,
            "properties": {"quarters": {"type": "array", "items": {"type": "string"}},
                           "emp": {"type": "array", "items": {"type": "integer"}},
                           "wage": {"type": "array", "items": {"type": "number"}},
                           "counties": {"type": "integer", "minimum": 0},
                           "fips": {"type": "array", "items": {"type": "string"}}}},
          "as_of": {"type": ["string", "null"]},
          "base_date": {"type": ["string", "null"]},
          "available": {"type": "boolean"},
          "thin_base": {"type": "boolean"},
          "wage": {"type": ["number", "null"]},
          "wage_cur": {"type": ["number", "null"]},
          "wage_yoy_pct": {"type": ["number", "null"]},
          "wage_spread_pp": {"type": ["number", "null"]},
          "emp": {"type": ["integer", "null"]},
          "emp_cur_total": {"type": ["integer", "null"]},
          "emp_yoy_pct": {"type": ["number", "null"]},
          "emp_spread_pp": {"type": ["number", "null"]},
          "yoy_basis": {"type": ["string", "null"], "enum": ["like_for_like", null]},
          "counties_total": {"type": "integer"},
          "counties_used": {"type": "integer"},
          "counties_suppressed": {"type": "array", "items": {"type": "string"}},
          "sites": {"type": "integer"},
          "mw_disclosed": {"type": "integer"},
          "sites_mw_undisclosed": {"type": "integer"},
          "mw_construction": {"type": "integer"},
          "mw_planned": {"type": "integer"},
          "mw_secured": {"type": "integer"},
          "mw_operating": {"type": "integer"},
          "market_pipeline": {
            "description": "The broker's market-level MW under construction for the region containing this market (or a null_note where it does not break the market out). Region is the broker's, not our county list: fit says how they compare. Operating and planned are from the same box, never summed. Additive (2026-10): optional for older artifacts; null when the config failed to load.",
            "type": ["object", "null"],
            "required": ["region", "label", "fit", "map_labels", "region_note", "mw_uc", "mw_operating", "mw_planned", "page", "quote", "null_note"],
            "additionalProperties": false,
            "properties": {
              "region": {"type": ["string", "null"]},
              "label": {"type": ["string", "null"]},
              "fit": {"type": ["string", "null"], "enum": ["close", "wider", "proxy", null]},
              "map_labels": {"type": "array", "items": {"type": "string"}},
              "region_note": {"type": ["string", "null"]},
              "mw_uc": {"type": ["integer", "null"], "minimum": 0},
              "mw_operating": {"type": ["integer", "null"], "minimum": 0},
              "mw_planned": {"type": ["integer", "null"], "minimum": 0},
              "page": {"type": ["integer", "null"], "minimum": 1},
              "quote": {"type": ["string", "null"]},
              "null_note": {"type": ["string", "null"]}
            }
          },
          "elec": {
            "description": "Private NAICS 238212 (nonresidential electrical contractors) for this market's counties, aggregated exactly like the NAICS 23 fields (pipeline/engine/dcmarkets.py). Additive (2026-10): optional at the row level for older artifacts; the writer always emits it.",
            "type": "object",
            "required": ["as_of", "base_date", "available", "partial", "yoy_basis",
                         "wage", "wage_yoy_pct", "wage_spread_pp", "emp",
                         "emp_yoy_pct", "emp_spread_pp", "wage_cur",
                         "emp_cur_total", "counties_total", "counties_used",
                         "counties_suppressed", "counties"],
            "properties": {
              "as_of": {"type": ["string", "null"]},
              "base_date": {"type": ["string", "null"]},
              "available": {"type": "boolean"},
              "partial": {"type": "boolean"},
              "yoy_basis": {"type": ["string", "null"], "enum": ["like_for_like", null]},
              "wage": {"type": ["number", "null"]},
              "wage_yoy_pct": {"type": ["number", "null"]},
              "wage_spread_pp": {"type": ["number", "null"]},
              "emp": {"type": ["integer", "null"]},
              "emp_yoy_pct": {"type": ["number", "null"]},
              "emp_spread_pp": {"type": ["number", "null"]},
              "wage_cur": {"type": ["number", "null"]},
              "emp_cur_total": {"type": ["integer", "null"]},
              "counties_total": {"type": "integer"},
              "counties_used": {"type": "integer"},
              "counties_suppressed": {"type": "array", "items": {"type": "string"}},
              "counties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["fips", "wage", "emp", "wage_yoy_pct", "emp_yoy_pct"],
                  "properties": {
                    "fips": {"type": "string"},
                    "wage": {"type": ["number", "null"]},
                    "emp": {"type": ["integer", "null"]},
                    "wage_yoy_pct": {"type": ["number", "null"]},
                    "emp_yoy_pct": {"type": ["number", "null"]}
                  }
                }
              }
            }
          },
          "counties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fips", "wage", "emp", "wage_yoy_pct", "emp_yoy_pct"],
              "properties": {
                "fips": {"type": "string"},
                "wage": {"type": ["number", "null"]},
                "emp": {"type": ["integer", "null"]},
                "wage_yoy_pct": {"type": ["number", "null"]},
                "emp_yoy_pct": {"type": ["number", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
